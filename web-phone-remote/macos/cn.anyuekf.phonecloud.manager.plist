<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cn.anyuekf.phonecloud.manager</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/Applications/手机管理端.app/Contents/MacOS/PhoneCloudManager</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Application Support/PhoneCloudManager/logs/manager-output.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Application Support/PhoneCloudManager/logs/manager-error.log</string>
</dict>
</plist>
